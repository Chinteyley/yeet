# Required on Vercel for yeet.ctey.dev. Prod fails closed without these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Also accepted if the integration still emits the old KV names.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional. If set, POST /api/throne requires this value via
# x-yeet-claim-token or Authorization: Bearer. Leave unset for the
# public game so anyone can yeet from the site.
# YEET_CLAIM_TOKEN=

# Optional extra Origin allowlist (comma-separated). The request host,
# https://yeet.ctey.dev, and VERCEL_URL are always allowed.
# YEET_ALLOWED_ORIGINS=

# Local / self-host only. Ignored on Vercel. Never a production store.
# There is no default public JSON-bin URL.
# YEET_JSON_URL=

# Optional public site URL for metadata / OG.
# NEXT_PUBLIC_SITE_URL=https://yeet.ctey.dev
